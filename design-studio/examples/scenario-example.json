    "directions": [
      {
        "id": "multi-layer-defense",
        "title": "海空联合多层拦截与拒止",
        "text": "依托近海防空阵地与水面编队形成内陆、海岸、远海三层拦截火力网。"
      },
      {
        "id": "asymmetric-chokepoint",
        "title": "通道不对称水下阻截",
        "text": "以潜艇布雷与无人潜航器封锁狭窄海峡出口。"
      },
      {
        "id": "rapid-reaction-strike",
        "title": "海空快速机动反击",
        "text": "依托机动航空力量对进犯水面编队实施快速突击。"
      }
    ],
    "brief": {
      "researchIntent": "检验海空联合防御体系在关键通道封控背景下的协同抗击能力与决策裁决机制。",
      "objective": "构建红蓝对抗仿真想定，在 72 小时推演周期内验证多波次海空反击在海峡通道的防御胜率与抗毁冗余。",
      "approach": "划分红蓝双方兵力编组，设定 4 个推演回合与裁决节点，运用抽象态势网格进行回合对抗仿真。",
      "assumptions": "假定红方岸基雷达网完好率大于 85%；蓝方水面编队在防区外展开；双方交战裁决依据规则库判定概率模型。",
      "expectedEffects": "形成多回合推演复盘数据，验证海空协同火力通道通畅率大于 80%，输出防御部署优化建议。",
      "risk": "复杂水文与恶劣海况可能降低水面编队协同反应速率。",
      "evidenceRefs": [
        "obs/想定推演/通道防御推演规则.md",
        "obs/战术协同/海空防空协同手册.md"
      ]
    },
