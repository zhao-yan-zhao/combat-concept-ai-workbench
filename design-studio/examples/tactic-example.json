    "directions": [
      {
        "id": "swarm-saturation",
        "title": "分布式协同饱和制压",
        "text": "通过低成本无人蜂群与电子压制单元协同，实现多轴向饱和突防与节点瘫痪。"
      },
      {
        "id": "stealth-penetration",
        "title": "隐蔽单点体系穿刺",
        "text": "依托多域隐身平台在重点走廊实施纵深快速突破。"
      },
      {
        "id": "standoff-interdiction",
        "title": "远距离防区外联合阻截",
        "text": "采用远距离非接触火力与信息扰乱限制对手机动。"
      }
    ],
    "brief": {
      "researchIntent": "探索分布式无人作战力量在复杂电磁环境下的体系协同机理与抗毁制胜路径。",
      "objective": "在 24 小时作战窗口内，通过多批次分布式蜂群协同突防，瓦解对手防御体系前沿雷达感知网与通信指挥链路，保障后续作战通道畅通。",
      "approach": "以低空分布式协同感知为先导，自组织网络与自主航迹解算为支撑，实施网络化电磁压制与多轴向饱和精确打击。",
      "assumptions": "假定战术数据链在强干扰下可降级维持近距自组织通信；机载自主决策算法通过预置规则库校验；协同打击时标同步误差在容许范围内。",
      "expectedEffects": "实现对手前沿感知网覆盖率下降 70% 以上，指挥响应时延增加 3 倍，达成防空火力通道饱和瘫痪。",
      "risk": "广域强电磁压制可能导致局部蜂群失联，需依赖预置自主规则完成降级退出。",
      "evidenceRefs": [
        "obs/战法机理/分布式蜂群协同.md",
        "obs/体系对抗/防空压制作战研究.md"
      ]
    },
